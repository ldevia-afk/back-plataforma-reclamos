@model CategoryListViewModel
@{
    ViewData["Title"] = "Categorías";
}
<h1>Categorías</h1>
<p class="gc-hint">
    Categorías internas para clasificar los casos ya recibidos (ej. "Sin movimiento causa cliente",
    "No se enviaron los insumos"). El cliente no las ve ni las elige: las asigna el perfil interno
    desde el detalle de cada caso.
</p>

<div class="gc-card">
    <div class="gc-card-title">Agregar categoría</div>
    <form asp-controller="Categories" asp-action="Create" method="post" class="gc-filters">
        @Html.AntiForgeryToken()
        <div class="gc-form-group">
            <label class="gc-label">Nombre</label>
            <input class="gc-input" name="Name" placeholder="Ej: Sin movimiento causa cliente" required />
        </div>
        <button type="submit" class="gc-btn">Agregar</button>
    </form>
</div>

<form method="get" class="gc-form-group" style="max-width:360px;">
    <input type="hidden" name="pageSize" value="@Model.Paging.PageSize" />
    <input class="gc-input" type="search" name="q" value="@Model.Q" placeholder="Buscar por nombre..."
           data-debounce-submit="400" />
</form>

<div class="gc-card">
    <table class="gc-table">
        <thead><tr><th>Nombre</th><th></th></tr></thead>
        <tbody>
            @foreach (var category in Model.Paging.Items)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>
                        <form asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" method="post" class="gc-inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="gc-link-button">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Paging.Items.Count == 0)
            {
                <tr><td colspan="2" class="gc-hint">Ninguna categoría coincide con la búsqueda.</td></tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model.Paging)
</div>
