@model List<BranchListItemViewModel>
@{
    ViewData["Title"] = "Sucursales";
}
<a asp-controller="Clients" asp-action="Index">&larr; Volver a Clientes y sucursales</a>
<h1>Sucursales</h1>

<div class="gc-form-group" style="max-width:360px;">
    <input class="gc-input" type="search" placeholder="Buscar por sucursal, cliente, dirección, país o estado..."
           data-live-search-for="branches-table" data-no-results-for="branches-no-results" />
</div>

<div class="gc-card">
    <table class="gc-table" id="branches-table">
        <thead><tr><th>Sucursal</th><th>Cliente</th><th>País</th><th>Dirección</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var branch in Model)
            {
                var statusDisplay = branch.IsActive ? "Activa" : "Inactiva";
                var searchText = string.Join(" ", new[]
                {
                    branch.Name, branch.ClientName, branch.ClientCode, branch.CountryName, branch.Address, statusDisplay
                }).ToLowerInvariant();

                <tr data-search="@searchText">
                    <td>@branch.Name</td>
                    <td>
                        <a asp-controller="Clients" asp-action="Edit" asp-route-id="@branch.ClientId">@branch.ClientName</a>
                        @if (!string.IsNullOrEmpty(branch.ClientCode))
                        {
                            <div class="gc-hint">Código @branch.ClientCode</div>
                        }
                    </td>
                    <td>@branch.CountryName</td>
                    <td>@(string.IsNullOrWhiteSpace(branch.Address) ? "-" : branch.Address)</td>
                    <td><span class="gc-status @(branch.IsActive ? "gc-status-Resuelto" : "gc-status-Inicial")">@statusDisplay</span></td>
                    <td><a asp-controller="Clients" asp-action="Edit" asp-route-id="@branch.ClientId">Gestionar</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="gc-hint">Todavía no hay sucursales cargadas.</td></tr>
            }
        </tbody>
    </table>
    <p id="branches-no-results" class="gc-hint" hidden>Ninguna sucursal coincide con la búsqueda.</p>
</div>
