@model BranchListViewModel
@{
    ViewData["Title"] = "Sucursales";
}
<a asp-controller="Clients" asp-action="Index">&larr; Volver a Clientes y sucursales</a>
<h1>Sucursales</h1>

<form method="get" class="gc-form-group" style="max-width:360px;">
    <input type="hidden" name="pageSize" value="@Model.Paging.PageSize" />
    <input class="gc-input" type="search" name="q" value="@Model.Q" placeholder="Buscar por sucursal, cliente, dirección, país o estado..."
           data-debounce-submit="400" />
</form>

<div class="gc-card">
    <table class="gc-table">
        <thead><tr><th>Sucursal</th><th>Cliente</th><th>País</th><th>Dirección</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var branch in Model.Paging.Items)
            {
                <tr>
                    <td>@branch.Name</td>
                    <td>
                        <a asp-controller="Clients" asp-action="Edit" asp-route-id="@branch.ClientId">@branch.ClientName</a>
                        @if (!string.IsNullOrEmpty(branch.ClientCode))
                        {
                            <div class="gc-hint">Código @branch.ClientCode</div>
                        }
                    </td>
                    <td>@branch.CountryName</td>
                    <td>@(string.IsNullOrWhiteSpace(branch.Address) ? "-" : branch.Address)</td>
                    <td><span class="gc-status @(branch.IsActive ? "gc-status-Resuelto" : "gc-status-Inicial")">@(branch.IsActive ? "Activa" : "Inactiva")</span></td>
                    <td><a asp-controller="Clients" asp-action="Edit" asp-route-id="@branch.ClientId">Gestionar</a></td>
                </tr>
            }
            @if (Model.Paging.Items.Count == 0)
            {
                <tr><td colspan="6" class="gc-hint">Ninguna sucursal coincide con la búsqueda.</td></tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model.Paging)
</div>
