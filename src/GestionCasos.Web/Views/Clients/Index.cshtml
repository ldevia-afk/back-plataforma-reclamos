@model ClientListViewModel
@{
    ViewData["Title"] = "Clientes y sucursales";
}
<h1>Clientes y sucursales</h1>

<a class="gc-btn" asp-controller="Clients" asp-action="Create" style="margin-bottom:16px;display:inline-block;">Nuevo cliente</a>
<a class="gc-btn gc-btn-secondary" asp-controller="Clients" asp-action="Branches" style="margin-bottom:16px;display:inline-block;">Ver sucursales</a>
<a class="gc-btn gc-btn-secondary" asp-controller="Clients" asp-action="Import" style="margin-bottom:16px;display:inline-block;">Importar desde Excel</a>

<form method="get" class="gc-filters gc-card">
    <input type="hidden" name="pageSize" value="@Model.Paging.PageSize" />
    <div class="gc-form-group">
        <label class="gc-label">Buscar</label>
        <input class="gc-input" type="search" name="q" value="@Model.Q" placeholder="Buscar por código, nombre o país..."
               data-debounce-submit="400" />
    </div>
    @if (Model.CanChooseCountry)
    {
        <div class="gc-form-group">
            <label class="gc-label">País</label>
            <select asp-for="FilterCountryId" class="gc-select" asp-items="Model.AvailableCountries.Select(c => new SelectListItem(c.Name, c.Id.ToString()))" onchange="this.form.submit()">
                <option value="">Todos</option>
            </select>
        </div>
    }
    <noscript><button type="submit" class="gc-btn">Filtrar</button></noscript>
</form>

<div class="gc-card">
    <table class="gc-table">
        <thead><tr><th>Código</th><th>Nombre</th><th>País</th><th>Sucursales</th><th></th></tr></thead>
        <tbody>
            @foreach (var client in Model.Paging.Items)
            {
                <tr>
                    <td>@client.ExternalCode</td>
                    <td>@client.Name</td>
                    <td>@client.CountryName</td>
                    <td>@client.BranchCount</td>
                    <td>
                        <a asp-controller="Clients" asp-action="Edit" asp-route-id="@client.Id">Editar / sucursales</a>
                        &nbsp;·&nbsp;
                        <form asp-controller="Clients" asp-action="Delete" asp-route-id="@client.Id" method="post" class="gc-inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="gc-link-button">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Paging.Items.Count == 0)
            {
                <tr><td colspan="5" class="gc-hint">Ningún cliente coincide con la búsqueda.</td></tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model.Paging)
</div>
