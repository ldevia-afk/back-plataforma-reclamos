@model ResolverGroupListViewModel
@{
    ViewData["Title"] = "Grupos resolutores";
}
<h1>Grupos resolutores</h1>

<a class="gc-btn" asp-controller="ResolverGroups" asp-action="Create" style="margin-bottom:16px;display:inline-block;">Nuevo grupo</a>

<form method="get" class="gc-form-group" style="max-width:360px;">
    <input type="hidden" name="pageSize" value="@Model.Paging.PageSize" />
    <input class="gc-input" type="search" name="q" value="@Model.Q" placeholder="Buscar por nombre o país..."
           data-debounce-submit="400" />
</form>

<div class="gc-card">
    <table class="gc-table">
        <thead><tr><th>Nombre</th><th>País</th><th>Miembros</th><th></th></tr></thead>
        <tbody>
            @foreach (var group in Model.Paging.Items)
            {
                <tr>
                    <td>
                        @group.Name
                        @if (group.IsHelpDesk)
                        {
                            <span class="gc-user-badge">Mesa de Ayuda</span>
                        }
                    </td>
                    <td>@group.CountryName</td>
                    <td>@group.MemberCount</td>
                    <td>
                        <a asp-controller="ResolverGroups" asp-action="Edit" asp-route-id="@group.Id">Editar</a>
                        &nbsp;·&nbsp;
                        <form asp-controller="ResolverGroups" asp-action="Delete" asp-route-id="@group.Id" method="post" class="gc-inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="gc-link-button">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Paging.Items.Count == 0)
            {
                <tr><td colspan="4" class="gc-hint">Ningún grupo coincide con la búsqueda.</td></tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model.Paging)
</div>
