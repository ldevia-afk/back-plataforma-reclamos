@model ResolverGroupFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo grupo resolutor" : "Editar grupo resolutor";
}
<h1>@ViewData["Title"]</h1>

<div class="gc-card">
    <form asp-controller="ResolverGroups" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="gc-form-group">
            <label class="gc-label">Nombre</label>
            <input asp-for="Name" class="gc-input" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>

        <div class="gc-form-group">
            <label class="gc-label">País</label>
            <select id="country-select" asp-for="CountryId" class="gc-select" asp-items="Model.AvailableCountries.Select(c => new SelectListItem(c.Name, c.Id.ToString()))">
                <option value="">-- Seleccioná --</option>
            </select>
            <span asp-validation-for="CountryId" class="field-validation-error"></span>
        </div>

        <div class="gc-form-group">
            <label class="gc-label">Miembros (usuarios de perfil Interno)</label>
            <div class="gc-checkbox-list">
                @foreach (var user in Model.AvailableUsers)
                {
                    <label class="gc-checkbox-item" data-user-country="@user.CountryId">
                        <input type="checkbox" name="MemberUserIds" value="@user.Id" checked="@(Model.MemberUserIds.Contains(user.Id))" />
                        @user.Name
                    </label>
                }
            </div>
            <p class="gc-hint">Sólo se muestran usuarios que ya existen. Los usuarios de otro país quedan ocultos automáticamente.</p>
        </div>

        <button type="submit" class="gc-btn">Guardar</button>
        <a class="gc-btn gc-btn-secondary" asp-controller="ResolverGroups" asp-action="Index">Cancelar</a>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var countrySelect = document.getElementById("country-select");
        function refresh() {
            var countryId = countrySelect.value;
            document.querySelectorAll("[data-user-country]").forEach(function (item) {
                item.hidden = item.getAttribute("data-user-country") !== countryId;
            });
        }
        countrySelect.addEventListener("change", refresh);
        refresh();
    });
</script>
