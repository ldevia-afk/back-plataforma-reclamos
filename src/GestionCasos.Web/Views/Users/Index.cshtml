@model UserListViewModel
@{
    ViewData["Title"] = "Usuarios";
}
<h1>Usuarios</h1>

<a class="gc-btn" asp-controller="Users" asp-action="Create" style="margin-bottom:16px;display:inline-block;">Nuevo usuario</a>

<form method="get" class="gc-form-group" style="max-width:360px;">
    <input type="hidden" name="pageSize" value="@Model.Paging.PageSize" />
    <input class="gc-input" type="search" name="q" value="@Model.Q" placeholder="Buscar por nombre, email, país, alcance o grupo..."
           data-debounce-submit="400" />
</form>

<div class="gc-card">
    <table class="gc-table">
        <thead><tr><th>Nombre</th><th>Email</th><th>Perfil</th><th>País</th><th>Alcance</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var user in Model.Paging.Items)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.ProfileDisplay</td>
                    <td>@user.CountryName</td>
                    <td>
                        @user.ScopeDisplay
                        @if (!string.IsNullOrEmpty(user.GroupNames))
                        {
                            <div class="gc-hint">Grupos: @user.GroupNames</div>
                        }
                    </td>
                    <td><span class="gc-status @(user.IsActive ? "gc-status-Resuelto" : "gc-status-Inicial")">@(user.IsActive ? "Activo" : "Inactivo")</span></td>
                    <td>
                        <a asp-controller="Users" asp-action="Details" asp-route-id="@user.Id">Ver</a>
                        &nbsp;·&nbsp;
                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id">Editar</a>
                        &nbsp;·&nbsp;
                        @if (user.IsActive)
                        {
                            <form asp-controller="Users" asp-action="Deactivate" asp-route-id="@user.Id" method="post" class="gc-inline-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="gc-link-button">Dar de baja</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Users" asp-action="Reactivate" asp-route-id="@user.Id" method="post" class="gc-inline-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="gc-link-button">Reactivar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Paging.Items.Count == 0)
            {
                <tr><td colspan="7" class="gc-hint">Ningún usuario coincide con la búsqueda.</td></tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model.Paging)
</div>
