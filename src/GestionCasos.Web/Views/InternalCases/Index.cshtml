@using Microsoft.AspNetCore.Http.Extensions
@model InternalInboxViewModel
@{
    ViewData["Title"] = "Bandeja de casos";
}
<h1>Bandeja de casos</h1>

<a class="gc-btn gc-btn-secondary" style="margin-bottom:16px;display:inline-block;"
   href="@Url.Action("ExportXlsx", new { q = Model.Q, filterType = Model.FilterType, filterCategoryId = Model.FilterCategoryId, filterStatus = Model.FilterStatus, filterGroupId = Model.FilterGroupId, dateFrom = Model.DateFrom, dateTo = Model.DateTo })">
    Exportar a Excel
</a>
<p class="gc-hint" style="margin-top:-8px;">Exporta todos los casos visibles con el filtro actualmente aplicado (si no filtrás nada, exporta todos).</p>

<form method="get" class="gc-filters gc-card">
    <input type="hidden" name="pageSize" value="@(Model.Paging?.PageSize ?? Paging.DefaultPageSize)" />
    <div class="gc-form-group">
        <label class="gc-label">Buscar</label>
        <input class="gc-input" type="search" name="q" value="@Model.Q" placeholder="Número, cliente, sucursal o detalle..."
               data-debounce-submit="400" />
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Tipo</label>
        <select asp-for="FilterType" class="gc-select" asp-items="Html.GetEnumSelectList<CaseType>()" onchange="this.form.submit()">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Categoría</label>
        <select asp-for="FilterCategoryId" class="gc-select" asp-items="Model.Categories.Select(c => new SelectListItem(c.Name, c.Id.ToString()))" onchange="this.form.submit()">
            <option value="">Todas</option>
        </select>
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Estado</label>
        <select asp-for="FilterStatus" class="gc-select" asp-items="Html.GetEnumSelectList<CaseStatus>()" onchange="this.form.submit()">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Grupo resolutor</label>
        <select asp-for="FilterGroupId" class="gc-select" asp-items="Model.ResolverGroups.Select(g => new SelectListItem(g.Name, g.Id.ToString()))" onchange="this.form.submit()">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Registrado desde</label>
        <input type="date" class="gc-input" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Registrado hasta</label>
        <input type="date" class="gc-input" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Vista</label>
        <select name="groupByType" class="gc-select" onchange="this.form.submit()">
            <option value="true" selected="@(Model.GroupByType ? "selected" : null)">Agrupada por tipo</option>
            <option value="false" selected="@(!Model.GroupByType ? "selected" : null)">Lista simple (con paginado)</option>
        </select>
    </div>
    <noscript><button type="submit" class="gc-btn">Filtrar</button></noscript>
</form>

<form id="bulk-form" asp-controller="InternalCases" asp-action="BulkChangeStatus" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@Context.Request.GetEncodedPathAndQuery()" />
    <input type="hidden" name="resolutionComment" id="bulk-resolution-comment" />

    @if (Model.AllCases.Count == 0)
    {
        <div class="gc-card"><p class="gc-hint">No hay casos que coincidan con el filtro.</p></div>
    }
    else
    {
        <div class="gc-bulk-toolbar">
            <select id="bulk-status-select" class="gc-select" style="width:auto;">
                @foreach (var status in Enum.GetValues<CaseStatus>())
                {
                    <option value="@((int)status)">@status.ToDisplayName()</option>
                }
            </select>
            <button type="button" id="bulk-update-btn" class="gc-btn">Actualizar seleccionados</button>
            <button type="button" id="bulk-sac-btn" class="gc-btn gc-btn-success">Enviar confirmación SAC a clientes</button>
            <span class="gc-hint">Marcá los casos en la tabla y elegí a qué estado pasarlos, o enviá la confirmación SAC de los que ya estén Resueltos.</span>
        </div>

        if (Model.GroupByType)
        {
            <p class="gc-hint">Vista agrupada: muestra todo lo que matchea el filtro, sin paginar. Para paginar, usá "Lista simple".</p>
            foreach (var group in Model.GroupedByType)
            {
                <div class="gc-category-block">
                    <div class="gc-category-heading">@group.Key (@group.Count())</div>
                    @await Html.PartialAsync("_CaseListTable", group.ToList())
                </div>
            }
        }
        else
        {
            <div class="gc-card">
                @await Html.PartialAsync("_CaseListTable", Model.AllCases)
                @if (Model.Paging != null)
                {
                    @await Html.PartialAsync("_Pagination", Model.Paging)
                }
            </div>
        }
    }
</form>

<div id="bulk-confirm-modal" class="gc-modal-overlay" hidden>
    <div class="gc-modal">
        <div class="gc-modal-header">
            <div class="gc-modal-title">Confirmar actualización masiva</div>
            <button type="button" id="bulk-close-btn" class="gc-modal-close" aria-label="Cerrar">&times;</button>
        </div>
        <p>Vas a actualizar <strong id="bulk-confirm-count">0</strong> caso(s) a estado <strong id="bulk-confirm-status"></strong>.</p>
        <div class="gc-form-group" id="bulk-comment-group" hidden>
            <label class="gc-label">Comentario de resolución (obligatorio)</label>
            <p class="gc-hint" style="margin-top:0;">Se va a usar como comentario de resolución en cada uno de los casos seleccionados.</p>
            <textarea id="bulk-comment-input" class="gc-input" rows="3"></textarea>
        </div>
        <div class="gc-modal-actions">
            <button type="button" id="bulk-cancel-btn" class="gc-btn gc-btn-secondary">Cancelar</button>
            <button type="button" id="bulk-confirm-btn" class="gc-btn">Confirmar</button>
        </div>
    </div>
</div>

<div id="bulk-sac-modal" class="gc-modal-overlay" hidden>
    <div class="gc-modal">
        <div class="gc-modal-header">
            <div class="gc-modal-title">Confirmar envío al cliente</div>
            <button type="button" id="bulk-sac-close-btn" class="gc-modal-close" aria-label="Cerrar">&times;</button>
        </div>
        <p>
            Vas a enviar la confirmación de resolución al cliente de <strong id="bulk-sac-count">0</strong> caso(s),
            usando el comentario de resolución ya cargado en cada uno.
        </p>
        <div class="gc-modal-actions">
            <button type="button" id="bulk-sac-cancel-btn" class="gc-btn gc-btn-secondary">Cancelar</button>
            <button type="button" id="bulk-sac-confirm-btn" class="gc-btn">Confirmar</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var RESUELTO_VALUE = "@((int)CaseStatus.Resuelto)";

        var updateBtn = document.getElementById("bulk-update-btn");
        var statusSelect = document.getElementById("bulk-status-select");
        var modal = document.getElementById("bulk-confirm-modal");
        var countEl = document.getElementById("bulk-confirm-count");
        var statusEl = document.getElementById("bulk-confirm-status");
        var commentGroup = document.getElementById("bulk-comment-group");
        var commentInput = document.getElementById("bulk-comment-input");
        var hiddenComment = document.getElementById("bulk-resolution-comment");
        var form = document.getElementById("bulk-form");

        if (!updateBtn) return;

        function selectedCheckboxes() {
            return Array.from(document.querySelectorAll(".gc-case-checkbox:checked"));
        }

        updateBtn.addEventListener("click", function () {
            var checked = selectedCheckboxes();
            if (checked.length === 0) {
                alert("Seleccioná al menos un caso.");
                return;
            }

            countEl.textContent = checked.length;
            statusEl.textContent = statusSelect.options[statusSelect.selectedIndex].text;
            var isResuelto = statusSelect.value === RESUELTO_VALUE;
            commentGroup.hidden = !isResuelto;
            commentInput.value = "";
            modal.hidden = false;
        });

        document.getElementById("bulk-cancel-btn").addEventListener("click", function () {
            modal.hidden = true;
        });

        document.getElementById("bulk-close-btn").addEventListener("click", function () {
            modal.hidden = true;
        });

        // Cerrar también haciendo click fuera del cuadro, o con Escape.
        modal.addEventListener("click", function (e) {
            if (e.target === modal) modal.hidden = true;
        });
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !modal.hidden) modal.hidden = true;
        });

        document.getElementById("bulk-confirm-btn").addEventListener("click", function () {
            var isResuelto = statusSelect.value === RESUELTO_VALUE;
            if (isResuelto && !commentInput.value.trim()) {
                alert("Ingresá el comentario de resolución.");
                return;
            }

            hiddenComment.value = commentInput.value;

            // El <select> de estado vive fuera del <form> (en la barra de herramientas),
            // así que agregamos su valor como campo oculto antes de enviar.
            var statusField = document.createElement("input");
            statusField.type = "hidden";
            statusField.name = "newStatus";
            statusField.value = statusSelect.value;
            form.appendChild(statusField);

            form.submit();
        });

        // --- Envío masivo de confirmación SAC: reusa el mismo form/checkboxes,
        // pero apunta a otra acción del controller antes de enviarlo. ---
        var sacBtn = document.getElementById("bulk-sac-btn");
        var sacModal = document.getElementById("bulk-sac-modal");
        var sacCountEl = document.getElementById("bulk-sac-count");

        if (sacBtn && sacModal) {
            sacBtn.addEventListener("click", function () {
                var checked = selectedCheckboxes();
                if (checked.length === 0) {
                    alert("Seleccioná al menos un caso.");
                    return;
                }
                sacCountEl.textContent = checked.length;
                sacModal.hidden = false;
            });

            document.getElementById("bulk-sac-cancel-btn").addEventListener("click", function () { sacModal.hidden = true; });
            document.getElementById("bulk-sac-close-btn").addEventListener("click", function () { sacModal.hidden = true; });
            sacModal.addEventListener("click", function (e) { if (e.target === sacModal) sacModal.hidden = true; });
            document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !sacModal.hidden) sacModal.hidden = true; });

            document.getElementById("bulk-sac-confirm-btn").addEventListener("click", function () {
                form.action = "@Url.Action("BulkConfirmResolution", "InternalCases")";
                form.submit();
            });
        }
    });
</script>
