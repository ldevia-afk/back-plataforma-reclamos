@model List<CaseListItemViewModel>
<table class="gc-table">
    <thead>
        <tr>
            <th><input type="checkbox" class="gc-select-all-in-table" title="Seleccionar todos" /></th>
            <th>Número</th>
            <th>Cliente</th>
            <th>Sucursal</th>
            <th>Tipo</th>
            <th>Categoría</th>
            <th>Estado</th>
            <th>Grupo</th>
            <th>Creado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><input type="checkbox" name="caseIds" value="@item.Id" class="gc-case-checkbox" /></td>
                <td>@item.Number</td>
                <td>@item.ClientName</td>
                <td>@item.BranchName</td>
                <td>@item.Type.ToDisplayName()</td>
                <td>@(item.CategoryName ?? "Sin categorizar")</td>
                <td><span class="gc-status gc-status-@item.Status">@item.Status.ToDisplayName()</span></td>
                <td>@(item.ResolverGroupName ?? "Sin asignar")</td>
                <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td><a asp-controller="InternalCases" asp-action="Details" asp-route-id="@item.Id">Gestionar</a></td>
            </tr>
        }
    </tbody>
</table>
