@model List<CaseListItemViewModel>
@{
    ViewData["Title"] = "Mis casos";
}
<h1>Mis casos</h1>

<a class="gc-btn" asp-controller="Cases" asp-action="Create" style="margin-bottom:16px;display:inline-block;">Nueva solicitud / consulta / reclamo</a>

<div class="gc-card">
    @if (Model.Count == 0)
    {
        <p class="gc-hint">Todavía no registraste ningún caso.</p>
    }
    else
    {
        <table class="gc-table">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Sucursal</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Creado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Number</td>
                        <td>@item.ClientName</td>
                        <td>@item.BranchName</td>
                        <td>@item.Type.ToDisplayName()</td>
                        <td><span class="gc-status gc-status-@item.Status">@item.Status.ToDisplayName()</span></td>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><a asp-controller="Cases" asp-action="Details" asp-route-id="@item.Id">Ver detalle</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
