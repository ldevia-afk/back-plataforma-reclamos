@model ClientCaseListViewModel
@{
    ViewData["Title"] = "Mis casos";
}
<h1>Mis casos</h1>

<a class="gc-btn" asp-controller="Cases" asp-action="Create" style="margin-bottom:16px;display:inline-block;">Nueva solicitud / consulta / reclamo</a>

<form method="get" class="gc-filters gc-card">
    <input type="hidden" name="pageSize" value="@Model.Paging.PageSize" />
    <div class="gc-form-group">
        <label class="gc-label">Buscar</label>
        <input class="gc-input" type="search" name="q" value="@Model.Q" placeholder="Número, sucursal, tipo o detalle..."
               data-debounce-submit="400" />
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Registrado desde</label>
        <input asp-for="DateFrom" class="gc-input" onchange="this.form.submit()" />
    </div>
    <div class="gc-form-group">
        <label class="gc-label">Registrado hasta</label>
        <input asp-for="DateTo" class="gc-input" onchange="this.form.submit()" />
    </div>
    <noscript><button type="submit" class="gc-btn">Filtrar</button></noscript>
</form>

<div class="gc-card">
    @if (Model.Paging.TotalCount == 0)
    {
        <p class="gc-hint">Ningún caso coincide con el filtro.</p>
    }
    else
    {
        <table class="gc-table">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Sucursal</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Creado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Paging.Items)
                {
                    <tr>
                        <td>@item.Number</td>
                        <td>@item.ClientName</td>
                        <td>@item.BranchName</td>
                        <td>@item.Type.ToDisplayName()</td>
                        <td><span class="gc-status gc-status-@item.Status">@item.Status.ToDisplayName()</span></td>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><a asp-controller="Cases" asp-action="Details" asp-route-id="@item.Id">Ver detalle</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @await Html.PartialAsync("_Pagination", Model.Paging)
</div>
