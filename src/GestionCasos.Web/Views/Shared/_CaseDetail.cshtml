@model CaseDetailViewModel

<h1>Caso @Model.Number</h1>

<div class="gc-card">
    @await Html.PartialAsync("_CaseStatusFlow", Model.Status)

    <table class="gc-table">
        <tr><th style="width:180px;">Cliente</th><td>@Model.ClientName</td></tr>
        <tr><th>País</th><td>@Model.CountryName</td></tr>
        <tr><th>Sucursal</th><td>@Model.BranchName</td></tr>
        <tr><th>Tipo</th><td>@Model.Type.ToDisplayName()</td></tr>
        <tr><th>Estado</th><td><span class="gc-status gc-status-@Model.Status">@Model.Status.ToDisplayName()</span></td></tr>
        <tr><th>Grupo resolutor</th><td>@(Model.ResolverGroupName ?? "Sin asignar")</td></tr>
        @if (Model.CanManage)
        {
            <tr><th>Categoría</th><td>@(Model.CategoryName ?? "Sin categorizar")</td></tr>
        }
        <tr><th>Creado por</th><td>@Model.CreatedByName</td></tr>
        <tr><th>Fecha de creación</th><td>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
    </table>

    <div class="gc-form-group" style="margin-top:16px;">
        <label class="gc-label">Detalle</label>
        <p>@Model.Description</p>
    </div>
</div>

@if (Model.ShowResolutionToClient)
{
    <div class="gc-card">
        <div class="gc-card-title">Resolución del caso</div>
        <table class="gc-table">
            <tr><th style="width:180px;">Sucursal</th><td>@Model.BranchName</td></tr>
            <tr><th>Fecha de inicio</th><td>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
            <tr><th>Fecha de finalización</th><td>@(Model.ResolvedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td></tr>
            <tr><th>Estado final</th><td><span class="gc-status gc-status-@Model.Status">@Model.Status.ToDisplayName()</span></td></tr>
        </table>
        <div class="gc-form-group" style="margin-top:12px;">
            <label class="gc-label">Comentario de resolución</label>
            <p>@Model.ResolutionComment</p>
        </div>
    </div>
}
else if (Model.Status == CaseStatus.Resuelto && !Model.CanManage)
{
    <div class="gc-card">
        <p class="gc-hint">Tu caso ya fue marcado como resuelto. En breve vas a recibir la confirmación con el detalle de la resolución.</p>
    </div>
}

@if (Model.CanManage)
{
    <div class="gc-card">
        <div class="gc-card-title">Gestión del caso</div>

        <form asp-controller="InternalCases" asp-action="AssignGroup" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="gc-filters">
                <div class="gc-form-group">
                    <label class="gc-label">Derivar a grupo resolutor</label>
                    <select name="resolverGroupId" class="gc-select" asp-items="Model.AvailableGroups.Select(g => new SelectListItem(g.Name, g.Id.ToString()))">
                        <option value="">-- Sin grupo --</option>
                    </select>
                </div>
            </div>
            <div class="gc-form-group">
                <label class="gc-label">Comentario / observación (opcional)</label>
                <textarea name="comment" class="gc-input" rows="2" placeholder="Ej: se deriva por incidencia de hardware, favor priorizar."></textarea>
            </div>
            <button type="submit" class="gc-btn">Derivar</button>
        </form>

        <form asp-controller="InternalCases" asp-action="ChangeStatus" method="post" style="margin-top:14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="gc-filters">
                <div class="gc-form-group">
                    <label class="gc-label">Cambiar estado</label>
                    <select id="new-status-select" name="newStatus" class="gc-select" asp-items="Html.GetEnumSelectList<CaseStatus>()"></select>
                </div>
            </div>
            <div id="resolution-comment-box" class="gc-alert" style="background:#fff4de;color:#92600a;" hidden>
                <div class="gc-form-group" style="margin-bottom:0;">
                    <label class="gc-label">Comentario de resolución (obligatorio)</label>
                    <p class="gc-hint" style="margin-top:0;">
                        Contale al cliente qué se hizo para resolver el caso. Mesa de Ayuda va a revisar este
                        mensaje antes de que el cliente pueda verlo.
                    </p>
                    <textarea id="resolution-comment-input" name="resolutionComment" class="gc-input" rows="3"></textarea>
                </div>
            </div>
            <button type="submit" class="gc-btn" style="margin-top:10px;">Actualizar estado</button>
        </form>

        <form asp-controller="InternalCases" asp-action="AssignCategory" method="post" class="gc-filters" style="margin-top:14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="gc-form-group">
                <label class="gc-label">Categorizar caso</label>
                <select asp-for="CategoryId" class="gc-select" asp-items="Model.AvailableCategories.Select(c => new SelectListItem(c.Name, c.Id.ToString()))">
                    <option value="">-- Sin categorizar --</option>
                </select>
            </div>
            <button type="submit" class="gc-btn">Guardar categoría</button>
        </form>
    </div>
}

@if (Model.CanManage && Model.Status == CaseStatus.Resuelto)
{
    if (Model.ResolutionConfirmed)
    {
        <div class="gc-card">
            <div class="gc-card-title">Mensaje al cliente</div>
            <p class="gc-alert gc-alert-success">
                Confirmado y enviado al cliente el @Model.ResolutionConfirmedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
            </p>
            <p>@Model.ResolutionComment</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.ResolutionComment))
    {
        <div class="gc-card">
            <div class="gc-card-title">Confirmar mensaje al cliente (Mesa de Ayuda)</div>
            <p class="gc-hint">
                Revisá el comentario de resolución del grupo resolutor. Podés editarlo antes de enviarlo:
                es lo que va a leer el cliente sobre el caso @Model.Number
                (sucursal @Model.BranchName, inicio @Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
                finalización @Model.ResolvedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
                estado final @Model.Status.ToDisplayName()).
            </p>
            <form asp-controller="InternalCases" asp-action="ConfirmResolution" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="gc-form-group">
                    <label class="gc-label">Mensaje para el cliente</label>
                    <textarea name="clientMessage" class="gc-input" rows="4">@Model.ResolutionComment</textarea>
                </div>
                <button type="submit" class="gc-btn">Guardar y enviar al cliente</button>
            </form>
        </div>
    }
}

<div class="gc-card">
    <div class="gc-card-title">Historial de estados</div>
    <ul class="gc-timeline">
        @foreach (var h in Model.StatusHistory)
        {
            <li>
                <strong>@h.Status.ToDisplayName()</strong> — @h.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                @if (h.ChangedByName != null) { <text> · @h.ChangedByName</text> }
            </li>
        }
    </ul>
</div>

<div class="gc-card">
    <div class="gc-card-title">Historial de derivaciones</div>
    <ul class="gc-timeline">
        @foreach (var h in Model.GroupHistory)
        {
            <li>
                <strong>@h.GroupName</strong> — @h.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                @if (h.ChangedByName != null) { <text> · @h.ChangedByName</text> }
                @if (!string.IsNullOrWhiteSpace(h.Comment))
                {
                    <div class="gc-hint">"@h.Comment"</div>
                }
            </li>
        }
    </ul>
</div>

@if (Model.CanManage)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var statusSelect = document.getElementById("new-status-select");
            var commentBox = document.getElementById("resolution-comment-box");
            var commentInput = document.getElementById("resolution-comment-input");
            if (!statusSelect || !commentBox || !commentInput) return;

            var resueltoValue = "@((int)CaseStatus.Resuelto)";

            function refresh() {
                var isResuelto = statusSelect.value === resueltoValue;
                commentBox.hidden = !isResuelto;
                commentInput.required = isResuelto;
            }

            statusSelect.addEventListener("change", refresh);
            refresh();
        });
    </script>
}
