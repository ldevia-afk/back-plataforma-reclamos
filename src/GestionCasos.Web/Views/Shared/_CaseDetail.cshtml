@using System.Text.Json
@model CaseDetailViewModel

<h1>Caso @Model.Number</h1>

<div class="gc-card">
    @await Html.PartialAsync("_CaseStatusFlow", Model.Status)

    <table class="gc-table">
        <tr><th style="width:180px;">Cliente</th><td>@Model.ClientName</td></tr>
        <tr><th>País</th><td>@Model.CountryName</td></tr>
        <tr><th>Sucursal</th><td>@Model.BranchName</td></tr>
        <tr><th>Tipo</th><td>@Model.Type.ToDisplayName()</td></tr>
        <tr><th>Estado</th><td><span class="gc-status gc-status-@Model.Status">@Model.Status.ToDisplayName()</span></td></tr>
        <tr><th>Grupo resolutor</th><td>@(Model.ResolverGroupName ?? "Sin asignar")</td></tr>
        @if (Model.CanManage)
        {
            <tr><th>Miembro asignado</th><td>@(Model.AssignedUserName ?? "Sin asignar")</td></tr>
            <tr><th>Categoría</th><td>@(Model.CategoryName ?? "Sin categorizar")</td></tr>
        }
        <tr><th>Creado por</th><td>@Model.CreatedByName</td></tr>
        <tr><th>Fecha de creación</th><td>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
    </table>

    <div class="gc-form-group" style="margin-top:16px;">
        <label class="gc-label">Detalle</label>
        <p>@Model.Description</p>
    </div>
</div>

@if (Model.ShowResolutionToClient)
{
    <div class="gc-card">
        <div class="gc-card-title">Resolución del caso</div>
        <table class="gc-table">
            <tr><th style="width:180px;">Sucursal</th><td>@Model.BranchName</td></tr>
            <tr><th>Fecha de inicio</th><td>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
            <tr><th>Fecha de finalización</th><td>@(Model.ResolvedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td></tr>
            <tr><th>Estado final</th><td><span class="gc-status gc-status-@Model.Status">@Model.Status.ToDisplayName()</span></td></tr>
        </table>
        <div class="gc-form-group" style="margin-top:12px;">
            <label class="gc-label">Comentario de resolución</label>
            <p>@Model.ResolutionComment</p>
        </div>
    </div>
}
else if (Model.Status == CaseStatus.Resuelto && !Model.CanManage)
{
    <div class="gc-card">
        <p class="gc-hint">Tu caso ya fue marcado como resuelto. En breve vas a recibir la confirmación con el detalle de la resolución.</p>
    </div>
}

@if (Model.CanManage)
{
    <div class="gc-card" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <button type="button" id="manage-case-btn" class="gc-btn">Gestionar caso</button>
        @if (Model.PendingSacConfirmation)
        {
            <button type="button" id="sac-btn" class="gc-btn gc-badge-sac">Pendiente confirmación SAC</button>
        }
        @if (Model.ResolutionConfirmed && Model.Status == CaseStatus.Resuelto)
        {
            <span class="gc-alert gc-alert-success" style="margin:0;">
                Confirmado y enviado al cliente el @Model.ResolutionConfirmedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
            </span>
        }
    </div>
}

@if (Model.SentEmails.Count > 0)
{
    <div class="gc-card">
        <div class="gc-card-title">Emails enviados</div>
        <p class="gc-hint" style="margin-top:0;">Este módulo de prueba no tiene un servidor de correo real conectado: acá podés ver el contenido tal cual se hubiera enviado.</p>
        <ul class="gc-timeline">
            @foreach (var email in Model.SentEmails.OrderByDescending(e => e.SentAtUtc))
            {
                <li>
                    <details>
                        <summary><strong>@email.Subject</strong> — para @email.ToEmail — @email.SentAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</summary>
                        <pre style="white-space:pre-wrap;font-family:inherit;margin:8px 0 0;">@email.Body</pre>
                    </details>
                </li>
            }
        </ul>
    </div>
}

@if (Model.CanManage)
{
    <div class="gc-card">
        <div class="gc-card-title">Historial del caso</div>
        <ul class="gc-timeline">
            @foreach (var h in Model.History)
            {
                <li>
                    <strong>@h.Title</strong> — @h.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    @if (h.ChangedByName != null)
                    {
                        <text> · @h.ChangedByName</text>
                        if (h.ChangedByGroupNames != null)
                        {
                            <text> (@h.ChangedByGroupNames)</text>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(h.Comment))
                    {
                        <div class="gc-hint">"@h.Comment"</div>
                    }
                </li>
            }
        </ul>
    </div>
}

@if (Model.CanManage)
{
    var groupMembersJson = JsonSerializer.Serialize(
        Model.AvailableGroups.ToDictionary(g => g.Id.ToString(), g => g.Members.Select(m => new { m.Id, m.Name }).ToList()));

    <div id="manage-case-modal" class="gc-modal-overlay" hidden>
        <div class="gc-modal">
            <div class="gc-modal-header">
                <div class="gc-modal-title">Gestionar caso @Model.Number</div>
                <button type="button" id="manage-case-close-btn" class="gc-modal-close" aria-label="Cerrar">&times;</button>
            </div>
            <form asp-controller="InternalCases" asp-action="ManageCase" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="gc-form-group">
                    <label class="gc-label">Grupo resolutor</label>
                    <select name="resolverGroupId" id="manage-group-select" class="gc-select">
                        <option value="">-- Sin grupo --</option>
                        @foreach (var g in Model.AvailableGroups)
                        {
                            <option value="@g.Id" selected="@(g.Id == Model.ResolverGroupId ? "selected" : null)">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="gc-form-group">
                    <label class="gc-label">Miembro asignado (opcional)</label>
                    <select name="assignedUserId" id="manage-member-select" class="gc-select" data-initial="@Model.AssignedUserId">
                        <option value="">-- Sin miembro específico --</option>
                    </select>
                </div>
                <div class="gc-form-group">
                    <label class="gc-label">Categoría</label>
                    <select asp-for="CategoryId" class="gc-select" asp-items="Model.AvailableCategories.Select(c => new SelectListItem(c.Name, c.Id.ToString()))">
                        <option value="">-- Sin categorizar --</option>
                    </select>
                </div>
                <div class="gc-form-group">
                    <label class="gc-label">Estado</label>
                    <select name="newStatus" class="gc-select">
                        @foreach (var s in Enum.GetValues<CaseStatus>())
                        {
                            <option value="@((int)s)" selected="@(s == Model.Status ? "selected" : null)">@s.ToDisplayName()</option>
                        }
                    </select>
                    <p class="gc-hint" style="margin-bottom:0;">Si lo pasás a Resuelto, el comentario de abajo se usa como detalle de la resolución para el cliente.</p>
                </div>
                <div class="gc-form-group">
                    <label class="gc-label">Observaciones o comentarios</label>
                    <textarea name="comment" class="gc-input" rows="3" placeholder="Observaciones sobre esta gestión (opcional, salvo al marcar Resuelto)."></textarea>
                </div>

                <div class="gc-modal-actions">
                    <button type="button" id="manage-case-cancel-btn" class="gc-btn gc-btn-secondary">Cancelar</button>
                    <button type="submit" class="gc-btn">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    if (Model.PendingSacConfirmation)
    {
        <div id="sac-modal" class="gc-modal-overlay" hidden>
            <div class="gc-modal">
                <div class="gc-modal-header">
                    <div class="gc-modal-title">Confirmar mensaje al cliente (SAC)</div>
                    <button type="button" id="sac-close-btn" class="gc-modal-close" aria-label="Cerrar">&times;</button>
                </div>
                <p class="gc-hint">
                    Revisá el comentario de resolución del grupo resolutor. Podés editarlo antes de enviarlo:
                    es lo que va a leer el cliente sobre el caso @Model.Number
                    (sucursal @Model.BranchName, inicio @Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
                    finalización @Model.ResolvedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
                    estado final @Model.Status.ToDisplayName()).
                </p>
                <form asp-controller="InternalCases" asp-action="ConfirmResolution" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="gc-form-group">
                        <label class="gc-label">Mensaje para el cliente</label>
                        <textarea name="clientMessage" class="gc-input" rows="4">@Model.ResolutionComment</textarea>
                    </div>
                    <div class="gc-modal-actions">
                        <button type="button" id="sac-cancel-btn" class="gc-btn gc-btn-secondary">Cancelar</button>
                        <button type="submit" class="gc-btn">Guardar y enviar al cliente</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var GROUP_MEMBERS = @Html.Raw(groupMembersJson);

            function wireModal(btnId, modalId, closeIds) {
                var btn = document.getElementById(btnId);
                var modal = document.getElementById(modalId);
                if (!btn || !modal) return;
                btn.addEventListener("click", function () { modal.hidden = false; });
                closeIds.forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.addEventListener("click", function () { modal.hidden = true; });
                });
                modal.addEventListener("click", function (e) { if (e.target === modal) modal.hidden = true; });
                document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !modal.hidden) modal.hidden = true; });
            }

            wireModal("manage-case-btn", "manage-case-modal", ["manage-case-close-btn", "manage-case-cancel-btn"]);
            wireModal("sac-btn", "sac-modal", ["sac-close-btn", "sac-cancel-btn"]);

            var groupSelect = document.getElementById("manage-group-select");
            var memberSelect = document.getElementById("manage-member-select");
            if (groupSelect && memberSelect) {
                function refreshMembers(preserveValue) {
                    var members = GROUP_MEMBERS[groupSelect.value] || [];
                    var valueToRestore = preserveValue !== undefined ? preserveValue : memberSelect.value;
                    memberSelect.innerHTML = '<option value="">-- Sin miembro específico --</option>';
                    members.forEach(function (m) {
                        var opt = document.createElement("option");
                        opt.value = m.Id;
                        opt.textContent = m.Name;
                        memberSelect.appendChild(opt);
                    });
                    if (members.some(function (m) { return String(m.Id) === String(valueToRestore); })) {
                        memberSelect.value = valueToRestore;
                    }
                }
                groupSelect.addEventListener("change", function () { refreshMembers(""); });
                refreshMembers(memberSelect.getAttribute("data-initial") || "");
            }
        });
    </script>
}
